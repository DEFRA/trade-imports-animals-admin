{
  "name": "trade-imports-animals-admin",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "build:frontend": "NODE_ENV=production webpack",
    "dev": "PORT=3001 AWS_EMF_ENVIRONMENT=Local run-p frontend:watch server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local run-p frontend:watch server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "frontend:watch": "NODE_ENV=development webpack --watch",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "postinstall": "npm run setup:husky",
    "lint": "run-s lint:js lint:templates lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:templates": "node eslint-rules/template-comments.js",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "pretest": "npm run build:frontend",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "security-audit": "audit-ci --config audit-ci.jsonc",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node --use-strict .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.7.0",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-secure-context": "0.4.2",
    "@defra/hapi-tracing": "1.30.2",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/bell": "13.2.1",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.1.0",
    "@hapi/cookie": "^12.0.1",
    "@hapi/crumb": "^9.0.1",
    "@hapi/hapi": "21.4.13",
    "@hapi/inert": "7.1.3",
    "@hapi/jwt": "3.2.4",
    "@hapi/scooter": "8.0.0",
    "@hapi/validate": "^2.0.1",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "18.1.3",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "9.9.0",
    "cssnano-preset-default": "9.8.0",
    "date-fns": "4.4.0",
    "global-agent": "4.1.7",
    "govuk-frontend": "6.6.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "ioredis": "6.0.0",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "semver": "7.8.6",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@babel/preset-env": "8.0.7",
    "@vitest/coverage-v8": "5.1.0",
    "audit-ci": "7.1.0",
    "autoprefixer": "10.6.2",
    "babel-loader": "10.1.1",
    "cheerio": "1.2.0",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "neostandard": "0.14.1",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "prettier": "3.10.1",
    "sass-embedded": "1.108.2",
    "sass-loader": "17.1.0",
    "source-map-loader": "5.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-gds": "3.0.0",
    "terser-webpack-plugin": "5.6.1",
    "vitest": "5.1.0",
    "vitest-fetch-mock": "0.4.5",
    "webpack": "5.112.2",
    "webpack-assets-manifest": "6.5.5",
    "webpack-cli": "7.3.1"
  },
  "overrides": {
    "blankie": {
      "@hapi/joi": "npm:joi@17.13.9"
    },
    "hapi-pulse": {
      "joi": "18.3.2"
    }
  }
}
