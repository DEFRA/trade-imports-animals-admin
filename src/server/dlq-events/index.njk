{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "trade-imports-animals-admin"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {% if banner %}
        <div class="govuk-notification-banner {{ 'govuk-notification-banner--success' if banner.type === 'success' }}"
             role="alert" aria-labelledby="dlq-banner-title" data-module="govuk-notification-banner">
          <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="dlq-banner-title">
              {{ 'Success' if banner.type === 'success' else 'Important' }}
            </h2>
          </div>
          <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">{{ banner.text }}</p>
          </div>
        </div>
      {% endif %}

      {% if messages.length %}
        <p class="govuk-body" data-testid="dlq-count">
          Showing {{ messages.length }} of approximately {{ approximateCount }} message(s) on the dead-letter queue.
        </p>

        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Id</th>
              <th scope="col" class="govuk-table__header">Message group</th>
              <th scope="col" class="govuk-table__header">Body</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for message in messages %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ message.id }}</td>
                <td class="govuk-table__cell">{{ message.messageGroupId }}</td>
                <td class="govuk-table__cell">
                  <details class="govuk-details">
                    <summary class="govuk-details__summary">
                      <span class="govuk-details__summary-text">View JSON</span>
                    </summary>
                    <div class="govuk-details__text">
                      <pre class="govuk-body-s" style="white-space: pre-wrap; word-break: break-all;">{{ message.bodyJson }}</pre>
                    </div>
                  </details>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <form method="post" action="/dlq-events" novalidate id="dlq-action-form">
          <input type="hidden" name="crumb" value="{{ crumb }}">
          <input type="hidden" name="action" id="dlq-action-input" value="">
          <div class="govuk-button-group">
            {{ govukButton({ text: "Replay all", type: "button", attributes: { id: "replay-all-btn" } }) }}
            {{ govukButton({ text: "Delete all", classes: "govuk-button--warning", type: "button", attributes: { id: "delete-all-btn" } }) }}
          </div>
        </form>

        <dialog id="delete-all-dialog" aria-labelledby="delete-all-dialog-title" aria-modal="true">
          <h2 class="govuk-heading-m" id="delete-all-dialog-title">
            Are you sure you want to delete all messages on the dead-letter queue?
          </h2>
          <p class="govuk-body">This permanently removes every message currently on the queue and cannot be undone.</p>
          {{ govukButton({ text: "Confirm delete all", classes: "govuk-button--warning", attributes: { id: "confirm-delete-all-btn" } }) }}
          {{ govukButton({ text: "Cancel", classes: "govuk-button--secondary", attributes: { id: "cancel-delete-all-btn", autofocus: "true" } }) }}
        </dialog>
      {% else %}
        <p class="govuk-body">There are no messages on the dead-letter queue.</p>
      {% endif %}

    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  {{ super() }}
  <script type="module" src="{{ getAssetPath('dlq-events.js') }}"></script>
{% endblock %}